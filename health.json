import React, { useState, useEffect } from 'react';
import { LineChart, Line, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, ScatterChart, Scatter, ZAxis } from 'recharts';
import { ArrowUpRight, ArrowDownRight, Activity, DollarSign, Heart, ShieldAlert, Award } from 'lucide-react';

export default function HealthDashboard({ countryCode = 'ABW' }) {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);

  // Fetch the unified merged dataset from your Python backend API
  useEffect(() => {
    fetch(`/api/dashboard/${countryCode}`)
      .then((res) => res.json())
      .then((data) => {
        setData(data);
        setLoading(false);
      })
      .catch((err) => console.error("Error loading dashboard data:", err));
  }, [countryCode]);

  if (loading || data.length === 0) {
    return <div className="flex h-screen items-center justify-center text-lg font-semibold">Loading Dashboard Engine...</div>;
  }

  // Extract current year data and previous year data for KPI comparison loops
  const currentData = data[data.length - 1];
  const previousData = data[data.length - 2] || currentData;

  // Helper calculation to determine directional trend arrows for KPI Cards
  const getTrend = (curr, prev, invert = false) => {
    const isHigher = curr > prev;
    const isGood = invert ? !isHigher : isHigher;
    if (curr === prev) return null;
    return (
      <span className={`inline-flex items-center text-xs font-medium ml-2 ${isGood ? 'text-green-600' : 'text-red-600'}`}>
        {isHigher ? <ArrowUpRight className="w-3 h-3 mr-0.5" /> : <ArrowDownRight className="w-3 h-3 mr-0.5" />}
        {(((curr - prev) / prev) * 100).toFixed(1)}%
      </span>
    );
  };

  return (
    <div className="min-h-screen bg-slate-50 p-6 font-sans text-slate-800">
      {/* HEADER SECTION */}
      <div className="mb-8">
        <h1 className="text-3xl font-bold tracking-tight text-slate-900">{currentData.country_name} Health Analytics</h1>
        <p className="text-slate-500 text-sm mt-1">{currentData.region} • {currentData.income_level} ({currentData.year} Snapshot)</p>
      </div>

      {/* 1. EXECUTIVE SUMMARY: TOP ROW KPI CARDS */}
      <div className="grid grid-cols-1 gap-5 sm:grid-cols-3 mb-8">
        {/* Card A: Life Expectancy */}
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p className="text-sm font-medium text-slate-500 uppercase tracking-wider">Life Expectancy</p>
            <div className="flex items-baseline mt-2">
              <span className="text-3xl font-bold tracking-tight">{currentData.life_expectancy?.toFixed(1)} yrs</span>
              {getTrend(currentData.life_expectancy, previousData.life_expectancy)}
            </div>
          </div>
          <div className="p-3 bg-emerald-50 rounded-lg text-emerald-600"><Heart className="w-6 h-6" /></div>
        </div>

        {/* Card B: Under-5 Mortality (Inverted direction: Down is good!) */}
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p className="text-sm font-medium text-slate-500 uppercase tracking-wider">Under-5 Mortality</p>
            <div className="flex items-baseline mt-2">
              <span className="text-3xl font-bold tracking-tight">{currentData.under5_mortality?.toFixed(1)}</span>
              <span className="text-xs text-slate-400 ml-1">/1k</span>
              {getTrend(currentData.under5_mortality, previousData.under5_mortality, true)}
            </div>
          </div>
          <div className="p-3 bg-rose-50 rounded-lg text-rose-600"><ShieldAlert className="w-6 h-6" /></div>
        </div>

        {/* Card C: Health Expenditure Per Capita */}
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p className="text-sm font-medium text-slate-500 uppercase tracking-wider">Health Spending / Capita</p>
            <div className="flex items-baseline mt-2">
              <span className="text-3xl font-bold tracking-tight">${currentData.health_expenditure_per_capita?.toLocaleString()}</span>
              {getTrend(currentData.health_expenditure_per_capita, previousData.health_expenditure_per_capita)}
            </div>
          </div>
          <div className="p-3 bg-blue-50 rounded-lg text-blue-600"><DollarSign className="w-6 h-6" /></div>
        </div>
      </div>

      {/* CHARTS ROW GRID */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        
        {/* 2. THE ECONOMIC ENGINE: HEALTH SPENDING VS WEALTH */}
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <div className="mb-4">
            <h3 className="text-lg font-bold text-slate-900">The Economic & Spending Engine</h3>
            <p className="text-slate-500 text-xs mt-0.5">Tracking national health infrastructure spending against GDP purchasing power over time</p>
          </div>
          <div className="h-80">
            <ResponsiveContainer width="100%" height="100%">
              <ScatterChart margin={{ top: 20, right: 20, bottom: 20, left: 10 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9" />
                <XAxis type="number" dataKey="gdp_per_capita_ppp" name="GDP Per Capita (PPP)" unit=" USD" stroke="#94a3b8" fontSize={12} />
                <YAxis type="number" dataKey="health_expenditure_pct_gdp" name="Health Spending" unit="%" stroke="#94a3b8" fontSize={12} />
                <ZAxis type="number" dataKey="year" name="Year" />
                <Tooltip cursor={{ strokeDasharray: '3 3' }} />
                <Scatter name="Yearly Progression" data={data} fill="#3b82f6" line={{ stroke: '#93c5fd', strokeWidth: 1.5 }} />
              </ScatterChart>
            </ResponsiveContainer>
          </div>
        </div>

        {/* 3. DISEASE BURDEN SHIFT: STACKED BAR TIMELINE */}
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <div className="mb-4">
            <h3 className="text-lg font-bold text-slate-900">The Disease Burden Shift</h3>
            <p className="text-slate-500 text-xs mt-0.5">Transition metric profile from communicable diseases to non-communicable/lifestyle chronic conditions</p>
          </div>
          <div className="h-80">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={data} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9" />
                <XAxis dataKey="year" stroke="#94a3b8" fontSize={12} />
                <YAxis stroke="#94a3b8" fontSize={12} unit="%" />
                <Tooltip />
                <Legend iconType="circle" wrapperStyle={{ fontSize: '12px' }} />
                <Bar dataKey="communicable_death_pct" name="Communicable Threats" stackId="disease_stack" fill="#f43f5e" radius={[0, 0, 0, 0]} />
                <Bar dataKey="noncommunicable_death_pct" name="Non-Communicable Chronic" stackId="disease_stack" fill="#475569" radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>
      </div>

      {/* 4. SYSTEM CAPACITY CHECK: RESOURCE INFRASTRUCTURE GRID */}
      <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div className="mb-6">
          <h3 className="text-lg font-bold text-slate-900">System Capacity Check</h3>
          <p className="text-slate-500 text-xs mt-0.5">Physical headcount assets per 1,000 citizens compared to standard global development targets</p>
        </div>
        
        <div className="space-y-6">
          {/* Progress Block 1: Physicians */}
          <div>
            <div className="flex justify-between text-sm font-medium mb-1">
              <span className="text-slate-700">Physicians per 1,000 People</span>
              <span className="font-bold text-slate-900">{currentData.physicians_per_1000?.toFixed(2)}</span>
            </div>
            <div className="w-full bg-slate-100 h-3 rounded-full overflow-hidden relative">
              <div className="bg-blue-600 h-full rounded-full transition-all duration-500" style={{ width: `${Math.min((currentData.physicians_per_1000 / 4) * 100, 100)}%` }}></div>
              <div className="absolute top-0 bottom-0 border-l-2 border-dashed border-slate-400 left-[62.5%]" title="Target Benchmark Target Line: 2.5"></div>
            </div>
          </div>

          {/* Progress Block 2: Nurses */}
          <div>
            <div className="flex justify-between text-sm font-medium mb-1">
              <span className="text-slate-700">Nurses and Midwives per 1,000 People</span>
              <span className="font-bold text-slate-900">{currentData.nurses_per_1000?.toFixed(2)}</span>
            </div>
            <div className="w-full bg-slate-100 h-3 rounded-full overflow-hidden relative">
              <div className="bg-emerald-600 h-full rounded-full transition-all duration-500" style={{ width: `${Math.min((currentData.nurses_per_1000 / 8) * 100, 100)}%` }}></div>
              <div className="absolute top-0 bottom-0 border-l-2 border-dashed border-slate-400 left-[62.5%]" title="Target Benchmark Target Line: 5.0"></div>
            </div>
          </div>

          {/* Progress Block 3: Hospital Beds */}
          <div>
            <div className="flex justify-between text-sm font-medium mb-1">
              <span className="text-slate-700">Hospital Beds per 1,000 People</span>
              <span className="font-bold text-slate-900">{currentData.hospital_beds_per_1000?.toFixed(2)}</span>
            </div>
            <div className="w-full bg-slate-100 h-3 rounded-full overflow-hidden relative">
